#!name = IPA Manager
#!desc = 下载IPA文件实现降级应用安装、已购下架应用安装。\n本插件依赖Scripting App且需解锁Pro权限。
#!openUrl = https://apps.apple.com/app/id6479691128
#!author = githubdulong[https://github.com/githubdulong]
#!tag = 功能增强
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://github.com/harmonizr/loon-plugins
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/iAppStore-03.png
#!date = 2026-10-02 12:00

# https://raw.githubusercontent.com/githubdulong/Script/master/Surge/ipaTool.sgmodule

[Script]
request if ${url} ~= /^https:\/\/apple-api\.com/i then script("https://raw.githubusercontent.com/harmonizr/loon-plugins/main/scripts/raw.githubusercontent.com/harmonizr__loon-plugins/main/scripts/loon.103516.xyz/Script/IPAManager/AppleStoreAPI.js") with tag="[IPA Manager]应用接口", requires_body=true

request if ${url} ~= /^https:\/\/xiaobai\.app/i then script("https://raw.githubusercontent.com/harmonizr/loon-plugins/main/scripts/raw.githubusercontent.com/harmonizr__loon-plugins/main/scripts/loon.103516.xyz/Script/IPAManager/InstallApp.js") with tag="[IPA Manager]应用安装"

[MitM]
hostname = apple-api.com, xiaobai.app